node_modules
.env
dist
backend/src/uploads

# Local .terraform directories
**/.terraform/*

# .tfstate files (contienen secretos)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do want to add to version control using negated pattern
# !example_override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc